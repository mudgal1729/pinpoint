# Pinpoint V0 environment template. Copy to .env.local and fill in
# ELEVENLABS_API_KEY by hand; everything else is written by
# scripts/setup-elevenlabs.mjs on first run.

# Required, fill in by hand. Source: ElevenLabs dashboard, Creator plan or
# higher (Conversational AI API endpoints are gated below Creator).
ELEVENLABS_API_KEY=

# Auto-populated by scripts/setup-elevenlabs.mjs --bootstrap.
# Swap voice IDs freely; re-run the script with --create to PATCH agents.
PINPOINT_SENDER_VOICE_ID=
PINPOINT_RECEIVER_VOICE_ID=

# Auto-populated by scripts/setup-elevenlabs.mjs. Do not edit by hand.
PINPOINT_SENDER_AGENT_ID=
PINPOINT_RECEIVER_AGENT_ID=
